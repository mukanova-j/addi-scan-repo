@page "/history"
@rendermode InteractiveServer
@implements IDisposable
@using AddiScan.Web.Services
@inject AddiScanApiClient Api
@inject AuthState AuthState

<PageTitle>Scan History</PageTitle>

<h1>Scan history</h1>

@if (!AuthState.IsAuthenticated)
{
    <p><a href="login">Log in</a> to see your scan history.</p>
}
else if (History is null)
{
    <p>Loading…</p>
}
else if (History.Count == 0)
{
    <p>You haven't scanned any labels yet.</p>
}
else
{
    @foreach (var item in History)
    {
        <div class="card mb-2 small">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-1 px-2">
                <span>@item.ScannedAt.ToLocalTime().ToString("g")</span>
                <a href="@($"/scans/{item.Id}")" class="btn btn-sm btn-outline-primary py-0">View scan details</a>
            </div>
            <div class="card-body py-2 px-2">
                <p class="text-muted mb-1" style="max-width: 100%; white-space: normal; word-break: break-word;">@item.ExtractedText</p>
                <p class="mb-0">
                    @if (item.OverallRiskBand is not null)
                    {
                        <span>
                            <strong>Overall risk:</strong>
                            <span class="badge @RiskBandStyle.CssClass(item.OverallRiskBand)">@RiskBandStyle.Label(item.OverallRiskBand)</span>
                            (driven by @item.WorstAdditiveName) —
                        </span>
                    }
                    <span>@item.Detected.Count additive(s) detected.</span>
                </p>
            </div>
        </div>
    }
}

@code {
    private List<ScanHistoryItem>? History { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthState.Changed += OnAuthChanged;
        if (AuthState.IsAuthenticated)
        {
            History = await Api.GetScanHistoryAsync();
        }
    }

    private async void OnAuthChanged()
    {
        History = AuthState.IsAuthenticated ? await Api.GetScanHistoryAsync() : null;
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthState.Changed -= OnAuthChanged;
    }
}
