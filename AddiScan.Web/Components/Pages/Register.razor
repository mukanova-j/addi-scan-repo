@page "/register"
@rendermode InteractiveServer
@using AddiScan.Web.Services
@inject AddiScanApiClient Api
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<EditForm Model="this" OnValidSubmit="SubmitAsync">
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" class="form-control" @bind-Value="Email" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="Password" />
    </div>
    <div class="mb-3 form-check">
        <InputCheckbox id="consent" class="form-check-input" @bind-Value="ConsentGiven" />
        <label for="consent" class="form-check-label">I consent to AddiScan storing my scan history, including photos of labels I upload.</label>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">Register</button>
</EditForm>

@if (ErrorMessage is not null)
{
    <p class="text-danger mt-3">@ErrorMessage</p>
}

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private bool ConsentGiven { get; set; }
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task SubmitAsync()
    {
        IsSubmitting = true;
        ErrorMessage = null;

        var result = await Api.RegisterAsync(Email, Password, ConsentGiven);
        if (result.Success && result.Token is not null)
        {
            AuthState.SignIn(Email, result.Token);
            Navigation.NavigateTo("/");
        }
        else
        {
            ErrorMessage = result.Error ?? "Registration failed.";
        }

        IsSubmitting = false;
    }
}
